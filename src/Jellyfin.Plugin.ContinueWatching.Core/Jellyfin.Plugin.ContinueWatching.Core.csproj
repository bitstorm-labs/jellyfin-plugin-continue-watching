<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately free of any Jellyfin reference: the ranking is plain logic over
    dates, so it builds on any SDK and tests in milliseconds. The plugin shell
    gathers the inputs from the server and hands them over.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Bitstorm Labs</Authors>
    <Copyright>Copyright (c) 2026 Bitstorm Labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
